        height: 33px;
        background: url('../../../../../../assets/HJ/ico/ico-lone.png');
        position: absolute;
        top: 350px;
        left: 50%;
      }
      .center {
        .addClass {
          width: 100px;
          /*position: absolute;*/
          /*bottom: 0px;*/
          /*right: -230px;*/
        }
        /*width: calc(100% - 120px);*/
        /*padding-top: 11px;*/
        display: flex;
        flex-direction: column;
        .right {
          overflow-y: auto;
          width: calc(100%);
          /*margin-top: 20px;*/
          height: calc(565px - 40px);
          padding: 0 40px 0 30px;
          position: relative;
        }
      }
      .bottom {
        .botBtn {
          width: 110px;
          height: 32px;
          background-image: url('../../../../../../assets/HJ/train/button.png');
        }
      }
      .rights {
        overflow-y: auto;
        width: calc(100%);
        /*margin-top: 20px;*/
        height: calc(575px);
        padding: 0 40px 0 30px;
        position: relative;
      }
    }
  }
