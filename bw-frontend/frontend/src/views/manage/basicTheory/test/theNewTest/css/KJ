@import "../../../../../../common/styles/KJ/colorAll";
.KJ{
  .titleColor{
    color:#e9deb2
  }
  .rightBg{ background: @modelBG;padding: 0px 20px 16px 20px;position: relative;}
  .inputself{width: 100px; height: 44px!important; line-height: 44px}
  /deep/.test>div:first-child {
    background: transparent !important;
  }
  /deep/ .modal {
    width: 100% !important;
  }
  .lable_box {
    display: flex;
    align-items: center;
    span {
      margin-right: 8px;
    }
  }
  /deep/.lable_box .ant-select-selector {
    border-color: #757165 !important;
  }
  /deep/.lable_box .ant-select-arrow-icon {
    color: #757165 !important;
  }
  /deep/ .ant-select-selection-search-input:focus {
    box-shadow: none !important;
  }
  ::v-deep(.ant-input-number-input){
    font-size: 20px;
    color: @KJbgColer !important;
  }
  .border {
    border-top: 1px solid #26332e;
    border-bottom: 1px solid #26332e;
    border-right: 1px solid #26332e;
    border-left: 0px;
  }
  .icon:hover {
    color: #ffffff !important;
  }
  .iconAdd{
    color: #a9abaa!important;
  }
  .iconAdd:hover {
    color: #04ecf5 !important;
  }
  .border:first-child {
    border-left: 1px solid #26332e;
  }
  .paper {
    background: rgba(31, 67, 99, 0.3);
    padding: 12px;

    .paperHead {
      display: flex;
      justify-content: space-between;
      height: 100px;
    }

    .paperBody {
      height: calc(100% - 150px);
    }

    .paperFooter {
      height: 50px;
      display: flex;
      justify-content: center;
      padding-top: 12px;
    }
  }
  .arrow {
    height: 48px;
    width: 170px;
    margin-top: -53px;
    background: url("../../../../../../assets/KJ/test/newJt.png") no-repeat 100%;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0;
    .wisdom .ant-input[disabled],
    .wisdom .ant-select-disabled .ant-select-selector,
    .wisdom .ant-input-number-disabled {
      color: #fff !important;
    }
  }
  .activeKnowledge {
    color: #70b9ec;
    font-weight: bolder;
  }
  .Cmenus_title:hover .actives {
    color: #ffffff;
  }
  .Cmenus_title:hover .numberA {
    color: #fff;
    background: #00920d;
  }
  .Cmenus_title_active {
    .actives {
      color: #7db29b !important;
      font-weight: bolder !important;
    }
    .numberA {
      color: #fff !important;
      background: @KJbgColer !important;
    }
  }
  .score {
    width: 70px;
    text-align: center;
    color: #fff;
  }
  .numberA {
    display: inline-block;
    width: 25px;
    height: 18px;
    background: @KJbgColer;
    border-radius: 10px;
    color: #fff;
    font-size: 12px;
    line-height: 16px;
    text-align: center;
    margin-top: 2px;
    margin-left: 10px;
  }
  .theTitle {
    font-size: 14px;
    color: #fff;
  }
  .theTitle2 {
    font-size: 16px;
    color: #e9deb2;
    font-weight: 800;
  }
  .title-top {
    display: flex;
    width: 430px;
    justify-content: center;
    align-items: center;
    background: url("../../../../../../assets/KJ/test/titleTop.png") no-repeat;
    background-size: contain;
  }
  .variableLine {
    margin: 0 33px;
    height: 31px;
  }
  .shadow {
    position: fixed;
    z-index: 1000;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    .shadowTwo {
      height: 350px !important;
      .bigboxTwo {
        height: calc(350px - 40px) !important;
      }
    }
    .shadowInfo {
