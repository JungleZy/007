        flex-direction: column;
        .right{
          overflow-y: auto;
          width:calc(100%);
          /*margin-top: 20px;*/
          height: calc(565px - 40px);
          padding: 0 40px 0 30px;
          position: relative;
        }
      }
      .bottom{
        .botBtn{
          width: 110px;
          height: 32px;
          background-image:url("../../../../../../../assets/KJ/train/button.png");
        }
      }
      .rights{
        overflow-y: auto;
