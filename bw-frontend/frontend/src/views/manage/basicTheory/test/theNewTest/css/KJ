  .topicList {
    font-size: 15px;
    color: rgba(255,255,255);
    line-height: 33px;
    transition: all 0.5s;
    border-radius: 3px;
    padding-left: 12px;
  }
  .topicList:hover {
    background: @KJbgColer;
    color: #ffffff !important;
    cursor: pointer;
  }
  .paperList {
    padding: 20px;
    border-bottom: 1px solid #3a403d;
    transition: all 0.5s;
    cursor: pointer;
  }
  .paperList:last-child {
    border-bottom: 0px solid #3a403d;
  }
