        flex-direction: column;
        .right {
          /*overflow-y: auto;*/
          width: calc(100%);
          /*margin-top: 20px;*/
          height: calc(565px - 40px);
          padding: 0 40px 0 30px;
          position: relative;
        }
      }
      .bottom {
        .botBtn {
          width: 110px;
          height: 32px;
          background-image: linear-gradient(#5c746b, #3d4c46);
        }
      }
      .rights {
        overflow-y: auto;
        width: calc(100%);
        /*margin-top: 20px;*/
        height: calc(575px);
        padding: 0 40px 0 30px;
        position: relative;
      }
    }
  }
