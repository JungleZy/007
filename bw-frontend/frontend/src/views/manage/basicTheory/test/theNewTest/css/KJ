        }
      }
      .newClosePopup .closeIco {
        transform: scale(0.8);
      }
      .bigbox {
        /*background: linear-gradient(to bottom right ,#172842,#163a63);*/
        margin-top: 26px;
        display: flex;
        .left {
          position: relative;
