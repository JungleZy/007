  .topicList {
    font-size: 15px;
    color: #a5b6d0;
    line-height: 33px;
    transition: all 0.5s;
    border-radius: 3px;
    padding-left: 12px;
  }
  .topicList:hover {
    background: #284c77;
    color: #ffffff !important;
  }
  .paperList {
    padding: 20px;
    border-bottom: 1px solid #213758;
    transition: all 0.5s;
  }
  .paperList:last-child {
    border-bottom: 0px solid #213758;
  }
