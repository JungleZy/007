.HJ{
  .textColor{
    color: #a5b6d0;
  }
  .titleColor{
    color: rgb(110, 194, 254)
  }
  .rightBg{ background: rgb(14 28 56);padding: 0px 20px 16px 20px;position: relative;}
  .inputself{width: 100px; height: 30px; line-height: 30px}
  .border {
    border-top: 1px solid #354971;
    border-bottom: 1px solid #354971;
    border-right: 1px solid #354971;
    border-left: 0px;
  }
  .icon:hover {
    color: #e2f2ff !important;
  }
  .iconAdd{
    color: #7b90af!important;
  }
  .iconAdd:hover {
    color: #6ebdff !important;
  }
  .border:first-child {
    border-left: 1px solid #354971;
  }
  .paper {
    background: rgba(24, 45, 86, 0.7);
    padding: 12px;

    .paperHead {
      display: flex;
      justify-content: space-between;
      height: 100px;
    }

    .paperBody {
      height: calc(100% - 150px);
    }

    .paperFooter {
      height: 50px;
      display: flex;
      justify-content: center;
      padding-top: 12px;
    }
  }
  .arrow {
    height: 95px;
    width: 120px;
    margin-top: -11px;
    padding: 10px;
    background: url('../../../../../../assets/HJ/test/jt.png') no-repeat 100%;
    text-align: center;
    .wisdom .ant-input[disabled],
    .wisdom .ant-select-disabled .ant-select-selector,
    .wisdom .ant-input-number-disabled {
      color: #fff !important;
    }
  }
  .activeKnowledge {
    color: #70b9ec;
    font-weight: bolder;
  }
  .Cmenus_title:hover .actives {
    color: #70b9ec;
    font-weight: bolder;
  }
  .Cmenus_title:hover .numberA {
    color: #0a1429;
    background: #6ebdff;
  }
  .Cmenus_title_active {
    .actives {
      color: #70b9ec !important;
      font-weight: bolder !important;
    }
    .numberA {
      color: #0a1429 !important;
      background: #6ebdff !important;
    }
  }
  .score {
    color: #bfcde0;
  }
  .numberA {
    display: inline-block;
    width: 25px;
    height: 18px;
    background: #3764a0;
    border-radius: 10px;
    color: #d2e1f0;
    font-size: 12px;
    line-height: 16px;
    text-align: center;
    margin-top: 2px;
    margin-left: 10px;
  }
  .theTitle {
    font-size: 14px;
    color: #bfcde0;
  }
  .theTitle2 {
    font-size: 16px;
    color: #6dbffb;
    font-weight: 800;
  }
  .variableLine {
    margin: 0 33px;
    height: 31px;
    border-right: 1px solid #182337;
  }
  .shadow {
    position: fixed;
    z-index: 1000;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
