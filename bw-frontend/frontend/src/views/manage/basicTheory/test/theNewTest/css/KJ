          border-color: #34b34c;
        }
      }
      .bottominfoTwo::before {
        content: "";
        width: 1px;
        height: 33px;
        background: url("../../../../../../assets/KJ/ico/ico-lone.png");
        position: absolute;
        top: 350px;
        left: 50%;
      }
      .center {
        .addClass {
          width: 100px;
          /*position: absolute;*/
          /*bottom: 0px;*/
          /*right: -230px;*/
        }
        /*width: calc(100% - 120px);*/
        /*padding-top: 11px;*/
